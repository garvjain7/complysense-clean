# Main API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@host/complysense?ssl=require

# MongoDB Atlas
# Stores document metadata/extracted text, control library documents, vendor contract text,
# and uploaded evidence file bytes via GridFS.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/complysense
MONGODB_DATABASE=complysense
MONGODB_DOCUMENTS_COLLECTION=documents
MONGODB_CONTROL_LIBRARY_COLLECTION=control_library

# Supabase Storage
# Stores the regulatory knowledge base used by the RAG indexer.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_KNOWLEDGE_BUCKET=knowledge-base

# Auth
SECRET_KEY=replace-with-a-strong-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=complysense_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
JWT_ALGORITHM=HS256

# AI Service
GEMINI_API_KEY=replace-with-your-gemini-api-key
LLM_MODEL=gemini-2.5-flash-lite
AI_SERVICE_URL=http://127.0.0.1:8001
MAIN_API_URL=http://127.0.0.1:8000
ADMIN_REINDEX_KEY=
AI_ADMIN_REINDEX_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# SMTP - Gmail address and App Password (leave blank to disable email delivery)
SMTP_USER=
SMTP_PASSWORD=
